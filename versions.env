# Single source of truth for every pinned tool/image/manifest version used by
# start-k8s.ps1, k8s/start-k8s.sh, k8s/deploy.sh, k8s/operator/install.sh,
# docker-compose.yml, k8s/ravendb/values.yaml, k8s/kind-config.yaml, Dockerfile,
# start.ps1, and .github/workflows/*.
#
# Bump exactly one line here, never inline elsewhere. Every value must be a real,
# currently-published release tag -- never a branch name (that's the bug this file
# exists to prevent: Calico/ingress-nginx used to be pulled from `master`/`main`).
#
# Plain KEY=value lines, no `export`, no quoting -- parsed directly by
# Read-VersionsEnv in start-k8s.ps1 and by `set -a; source versions.env` in bash.

CALICO_VERSION=v3.32.1
# kubernetes/ingress-nginx was archived 2026-03-24 -- this is the last released
# tag. Pin and freeze here; switching ingress controllers is a separate decision.
INGRESS_NGINX_VERSION=controller-v1.15.1
KIND_VERSION=v0.32.0
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5
KUBECTL_VERSION=v1.36.3
HELM_VERSION=v3.21.3
# FireDaemon.OpenSSL winget package version (Windows only -- Linux uses system openssl)
OPENSSL_VERSION=4.0.1
CERT_MANAGER_VERSION=v1.16.2
RAVENDB_OPERATOR_CHART_VERSION=2.0.0
RAVENDB_CLUSTER_CHART_VERSION=1.0.0
RAVENDB_IMAGE_TAG=7.2.4-ubuntu.24.04-x64
PYTHON_IMAGE_TAG=3.13.14-slim
UV_VERSION=0.12.2
