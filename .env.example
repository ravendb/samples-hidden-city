# Copy to .env and fill in your values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Flight APIs
KIWI_API_KEY=...
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
