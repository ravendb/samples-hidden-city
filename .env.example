# Copy to .env and fill in your values. Never commit .env.

# OpenAI
OPENAI_API_KEY=sk-...

# Flight APIs
TRAVELPAYOUTS_TOKEN=...
TRAVELPAYOUTS_MARKER=...   # partner ID, needed for the Flight Search hub lookup
MAX_HUB_LOOKUPS_PER_ORIGIN=25   # optional; caps real-time hub lookups per scrape cycle

# RavenDB (local dev — matches docker-compose.yml)
RAVENDB_URL=http://localhost:8080
RAVENDB_DATABASE=hidden-city

# Agent
LLM_MODEL=gpt-4o-mini
MAX_TOKENS_BUDGET=1500
