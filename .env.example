# RavenDB (local dev — matches docker-compose.yml)
RAVENDB_URL=http://localhost:8080
RAVENDB_DATABASE=hidden-city

# Agent
LLM_MODEL=claude-sonnet-4-20250514
MAX_TOKENS_BUDGET=1500
